{
  "name": "lms-tutoring-credit-automation",
  "version": "0.1.0",
  "description": "LMS 관리자 페이지를 순회하며 강사별 보강권 지급 현황을 구글 시트에 자동 기록하는 사내 자동화 도구",
  "main": "electron/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:overdue-exe": "node scripts/build-overdue-exe.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "co.kr.talkstation.lms-overdue-report",
    "productName": "미납자 관리",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!electron/**/*.map"
    ],
    "extraResources": [
      {
        "from": "python/dist/worker",
        "to": "worker"
      }
    ],
    "win": {
      "target": "portable"
    }
  }
}
